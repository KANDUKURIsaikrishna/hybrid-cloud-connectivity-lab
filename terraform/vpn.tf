# =============================================================================
# CUSTOMER GATEWAY  = AWS's record of "my on-prem VPN device"
# It is just the device's public IP (our Elastic IP) + a BGP ASN.
# =============================================================================
resource "aws_customer_gateway" "onprem" {
  bgp_asn    = var.onprem_bgp_asn # AWS requires a value even for static routing
  ip_address = aws_eip.onprem.public_ip
  type       = "ipsec.1"

  tags = { Name = "${var.project_name}-cgw" }
}

# =============================================================================
# SITE-TO-SITE VPN attached to the Transit Gateway.
# AWS always creates TWO tunnels (two endpoints in different AZs) for HA.
#
# NOTE: changing static_routes_only (static <-> bgp) FORCES A NEW VPN CONNECTION.
#       New tunnel IPs and new PSKs => re-run terraform apply, re-copy onprem/,
#       re-run install_strongswan.sh. (Explained in 03_DEPLOYMENT_GUIDE.)
# =============================================================================
resource "aws_vpn_connection" "onprem" {
  customer_gateway_id = aws_customer_gateway.onprem.id
  transit_gateway_id  = aws_ec2_transit_gateway.main.id
  type                = "ipsec.1"
  static_routes_only  = var.vpn_routing_mode == "static"

  # Fixed inside (link-local) tunnel addresses so the lab is predictable.
  # In each /30: .1 = AWS side, .2 = our side.
  tunnel1_inside_cidr = "169.254.10.0/30"
  tunnel2_inside_cidr = "169.254.11.0/30"

  # We initiate from strongSwan; AWS just waits ("add").
  tunnel1_startup_action = "add"
  tunnel2_startup_action = "add"

  # ---- IKE phase 1 + IPsec phase 2 parameters (modern, strong, same on both tunnels) ----
  # These MUST match swanctl.conf.template: aes256-sha256-modp2048
  tunnel1_ike_versions                 = ["ikev2"]
  tunnel1_phase1_encryption_algorithms = ["AES256"]
  tunnel1_phase1_integrity_algorithms  = ["SHA2-256"]
  tunnel1_phase1_dh_group_numbers      = [14]
  tunnel1_phase1_lifetime_seconds      = 28800
  tunnel1_phase2_encryption_algorithms = ["AES256"]
  tunnel1_phase2_integrity_algorithms  = ["SHA2-256"]
  tunnel1_phase2_dh_group_numbers      = [14]
  tunnel1_phase2_lifetime_seconds      = 3600
  tunnel1_dpd_timeout_seconds          = 30
  tunnel1_dpd_timeout_action           = "clear"

  tunnel2_ike_versions                 = ["ikev2"]
  tunnel2_phase1_encryption_algorithms = ["AES256"]
  tunnel2_phase1_integrity_algorithms  = ["SHA2-256"]
  tunnel2_phase1_dh_group_numbers      = [14]
  tunnel2_phase1_lifetime_seconds      = 28800
  tunnel2_phase2_encryption_algorithms = ["AES256"]
  tunnel2_phase2_integrity_algorithms  = ["SHA2-256"]
  tunnel2_phase2_dh_group_numbers      = [14]
  tunnel2_phase2_lifetime_seconds      = 3600
  tunnel2_dpd_timeout_seconds          = 30
  tunnel2_dpd_timeout_action           = "clear"

  tags = { Name = "${var.project_name}-vpn" }
}

# =============================================================================
# GENERATED FILES for the on-prem strongSwan box (both are gitignored)
#   onprem/swanctl.conf : tunnel config INCLUDING pre-shared keys (secret!)
#   onprem/lab.env      : non-secret values (IPs, inside addresses, mode)
# =============================================================================
resource "local_sensitive_file" "swanctl_conf" {
  filename        = "${path.module}/../onprem/swanctl.conf"
  file_permission = "0600"

  content = templatefile("${path.module}/../onprem/swanctl.conf.template", {
    cgw_public_ip = aws_eip.onprem.public_ip
    t1_outside_ip = aws_vpn_connection.onprem.tunnel1_address
    t2_outside_ip = aws_vpn_connection.onprem.tunnel2_address
    t1_psk        = aws_vpn_connection.onprem.tunnel1_preshared_key
    t2_psk        = aws_vpn_connection.onprem.tunnel2_preshared_key
    t1_if_id      = 101
    t2_if_id      = 102
  })
}

resource "local_file" "lab_env" {
  filename        = "${path.module}/../onprem/lab.env"
  file_permission = "0644"

  content = <<-EOT
    # Generated by Terraform. Do not edit. Gitignored.
    ROUTING_MODE=${var.vpn_routing_mode}
    ONPREM_PRIVATE_IP=${aws_instance.onprem.private_ip}
    ONPREM_VPC_CIDR=${var.onprem_vpc_cidr}
    ONPREM_SUBNET_CIDR=${var.onprem_public_subnet_cidr}
    ONPREM_ASN=${var.onprem_bgp_asn}
    AWS_ASN=${var.tgw_asn}
    AWS_PREFIXES="${join(" ", [for v in var.aws_vpcs : v.vpc_cidr])}"
    T1_IF_ID=101
    T1_CGW_INSIDE=${aws_vpn_connection.onprem.tunnel1_cgw_inside_address}
    T1_AWS_INSIDE=${aws_vpn_connection.onprem.tunnel1_vgw_inside_address}
    T2_IF_ID=102
    T2_CGW_INSIDE=${aws_vpn_connection.onprem.tunnel2_cgw_inside_address}
    T2_AWS_INSIDE=${aws_vpn_connection.onprem.tunnel2_vgw_inside_address}
  EOT
}
